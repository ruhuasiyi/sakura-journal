<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, viewport-fit=cover">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5/index.css">
  <!-- 深色模式暂时下线：不注入 data-theme，始终走 tokens.css 的亮色令牌。
       暗色样式仍保留在 CSS 里，恢复时把切换按钮和初始化脚本加回来即可。 -->
  <meta name="google-site-verification" content="googleccdc80b5acff15be">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
  <%
  var metaDesc = page.description ||
    (page.excerpt ? strip_html(page.excerpt) : '') ||
    (is_post() ? truncate(strip_html(page.content), { length: 80 }) : '') ||
    config.description;
  metaDesc = String(metaDesc).replace(/\s+/g, ' ').replace(/"/g, '&quot;').trim();
  %>
  <meta name="description" content="<%= metaDesc %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:title" content="<%= page.title || config.title %>">
  <meta property="og:description" content="<%= metaDesc %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:url" content="<%- full_url_for(page.path).replace(/index\.html$/, '') %>">
  <meta property="og:image" content="<%= config.url %>/images/avatar.jpg">
  <script>window.PB_COVERS = <%- JSON.stringify(config.pb_covers || []) %>;</script>
  <script>window.PB_FITNESS = { dataUrl: '<%= theme.fitness ? theme.fitness.dataUrl : '' %>' };</script>
  <script>window.PB_WALINE = {
      serverURL: '<%= theme.comment.waline ? theme.comment.waline.serverURL : '' %>',
      lang: '<%= theme.comment.waline ? theme.comment.waline.lang : "zh-CN" %>',
      module: '/waline/waline.js',
      emoji: <%- JSON.stringify((theme.comment.waline && theme.comment.waline.emoji) || false) %>
    };</script>
  <link rel="stylesheet" href="/waline/waline.css">
  <%- css('css/tokens') %>
  <%- css('css/base') %>
  <%- css('css/components') %>
</head>
<body>
  <%- partial('_partial/nav') %>
  <main class="container">
    <%- body %>
  </main>
  <%- partial('_partial/footer') %>
  <script>
  // 必须在 pbInitPage 之前抓：此时 main 还是服务端原始 HTML，
  // 不含代码块标签、封面卡、TOC、Waline 挂载后的 DOM。路由缓存用这份干净快照，
  // 回退重放时才不会出现重复的 .highlight-wrap / 封面卡 / Waline DOM。
  (function () {
    var main = document.querySelector('main.container');
    // outerHTML：与 router.js 网络取页时缓存的 main.outerHTML 保持同一形状
    window.PB_BOOT = { main: main ? main.outerHTML : '', title: document.title };
  })();
  </script>
  <%- js('js/runs') %>
  <%- js('js/toc') %>
  <%- js('js/router') %>
  <% if (theme.analytics && theme.analytics.umami) { %>
  <script defer src="<%= theme.analytics.umami.script %>" data-website-id="<%= theme.analytics.umami.websiteId %>"></script>
  <% } %>
  <% if (theme.live2d.enable) { %><%- js('js/live2d') %><% } %>
  <% if (theme.effects.trail) { %><%- js('js/trail') %><% } %>
  <% if (theme.effects.sakura) { %><%- js('js/sakura') %><% } %>
</body>
</html>
