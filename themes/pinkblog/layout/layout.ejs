<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, viewport-fit=cover">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont/style.css">
  <script>
  (function () {
    try {
      var t = localStorage.getItem('pb-theme');
      if (t !== 'dark' && t !== 'light') {
        t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.dataset.theme = t;
    } catch (e) {}
  })();
  </script>
  <meta name="google-site-verification" content="googleccdc80b5acff15be">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
  <%
  var metaDesc = page.description ||
    (page.excerpt ? strip_html(page.excerpt) : '') ||
    (is_post() ? truncate(strip_html(page.content), { length: 80 }) : '') ||
    config.description;
  metaDesc = String(metaDesc).replace(/\s+/g, ' ').replace(/"/g, '&quot;').trim();
  %>
  <meta name="description" content="<%= metaDesc %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:title" content="<%= page.title || config.title %>">
  <meta property="og:description" content="<%= metaDesc %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:url" content="<%= config.url %>/<%= page.path %>">
  <meta property="og:image" content="<%= config.url %>/images/avatar.jpg">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <script>window.PB_WALINE = {
      serverURL: '<%= theme.comment.waline ? theme.comment.waline.serverURL : '' %>',
      lang: '<%= theme.comment.waline ? theme.comment.waline.lang : "zh-CN" %>',
      module: '/waline/waline.js',
      emoji: <%- JSON.stringify(theme.comment.waline.emoji || false) %>
    };</script>
  <link rel="stylesheet" href="/waline/waline.css">
  <%- css('css/tokens') %>
  <%- css('css/base') %>
  <%- css('css/components') %>
</head>
<body>
  <%- partial('_partial/nav') %>
  <main class="container">
    <%- body %>
  </main>
  <%- partial('_partial/footer') %>
  <script>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var root = document.documentElement;
    btn.addEventListener('click', function () {
      var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('pb-theme', next); } catch (e) {}
      var gi = document.querySelector('iframe.giscus-frame');
      if (gi) gi.contentWindow.postMessage(
        { giscus: { setConfig: { theme: 'https://rhsy.moe/css/giscus-' + next + '.css' } } },
        'https://giscus.app');
    });
  })();
  </script>
  <%- js('js/toc') %>
  <script>
  // hover 预取：悬停站内链接 60ms 后预拉目标页，配合 View Transitions 实现瞬时切换
  (function () {
    var prefetched = new Set();
    function prefetch(url) {
      if (prefetched.has(url)) return;
      prefetched.add(url);
      var l = document.createElement('link');
      l.rel = 'prefetch';
      l.href = url;
      document.head.appendChild(l);
    }
    document.addEventListener('mouseover', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a || a.host !== location.host || a.hasAttribute('download') ||
          a.href.indexOf('#') > -1 || a.pathname === location.pathname) return;
      setTimeout(function () { if (a.matches(':hover')) prefetch(a.href); }, 60);
    }, { passive: true });
  })();
  </script>
  <script>
  // 轻量路由：站内跳转 fetch 换页 + 同页 View Transition（卡片 morph 到文章页）
  // 配合 toc.js 暴露的 window.pbInitPage() 完成换页后重初始化
  (function () {
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    function vtName(path) {
      var h = 5381;
      for (var i = 0; i < path.length; i++) h = ((h << 5) + h + path.charCodeAt(i)) >>> 0;
      return 'post-' + h.toString(36);
    }
    var scrollMap = {};  // 记录每个页面的滚动位置，后退时恢复（sessionStorage 持久化，F5 不丢）
    try {
      scrollMap = JSON.parse(sessionStorage.getItem('pb-scroll') || '{}');
    } catch (e) {}
    function saveScrollMap() {
      try { sessionStorage.setItem('pb-scroll', JSON.stringify(scrollMap)); } catch (e) {}
    }
    window.addEventListener('pagehide', function () {
      scrollMap[curUrl] = window.scrollY;
      saveScrollMap();
    });
    function swap(url) {
      return fetch(url).then(function (res) { return res.text(); }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var newMain = doc.querySelector('main.container');
        var oldMain = document.querySelector('main.container');
        if (!newMain || !oldMain) { location.href = url; return; }
        document.title = doc.title;
        oldMain.replaceWith(document.adoptNode(newMain));
        window.pbInitPage && window.pbInitPage();
      });
    }
    var curUrl = location.href;  // 自己跟踪当前页 URL——popstate 触发时 location 已变成目标页
    function navigate(url, push) {
      // 保存"离开页"的位置：必须用离开页自己的 URL 作键（location.href 此时已是目标页）
      scrollMap[curUrl] = window.scrollY;
      saveScrollMap();
      function go() {
        return swap(url).then(function () {
          // 前进到新页 → 回到顶部；后退 → 恢复离开时的位置
          window.scrollTo(0, push ? 0 : (scrollMap[url] || 0));
        });
      }
      if (document.startViewTransition) {
        document.startViewTransition(go);
      } else {
        go();
      }
      if (push) history.pushState({}, '', url);
      curUrl = url;
    }
    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a || a.host !== location.host || a.target === '_blank' || a.hasAttribute('download')) return;
      // 纯锚点（同页 #）走默认行为
      if (a.pathname === location.pathname && a.hash) return;
      e.preventDefault();
      // 只给被点击的卡片挂过渡名（与文章页静态名配对），避免多命名组互相打架
      var card = a.closest('.post-card');
      if (card && document.startViewTransition) {
        card.style.viewTransitionName = vtName(decodeURIComponent(a.pathname).slice(1));
        document.startViewTransition && (function (c) {
          var clear = function () { setTimeout(function () { c.style.viewTransitionName = ''; }); };
          document.addEventListener('viewtransitiondone', clear, { once: true });
          setTimeout(clear, 900);  // 兜底：VT API 无完成事件时的保守清理
        })(card);
      }
      navigate(a.href, true);
    });
    window.addEventListener('popstate', function () { navigate(location.href, false); });
  })();
  </script>
  <% if (theme.analytics && theme.analytics.umami) { %>
  <script defer src="<%= theme.analytics.umami.script %>" data-website-id="<%= theme.analytics.umami.websiteId %>"></script>
  <% } %>
  <% if (theme.live2d.enable) { %><%- js('js/live2d') %><% } %>
  <% if (theme.effects.trail) { %><%- js('js/trail') %><% } %>
  <% if (theme.effects.sakura) { %><%- js('js/sakura') %><% } %>
</body>
</html>
