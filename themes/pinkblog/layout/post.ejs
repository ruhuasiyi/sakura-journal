<div class="post-layout">
  <% function vtName(path) { var h = 5381; for (var i = 0; i < path.length; i++) { h = ((h << 5) + h + path.charCodeAt(i)) >>> 0; } return 'post-' + h.toString(36); } %>
  <article class="card post-content-wrap" style="view-transition-name: <%= vtName(page.path) %>">
    <span class="tape" aria-hidden="true"></span>
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <span class="stamp"><%= date(page.date, 'YYYY-MM-DD') %></span>
      <% page.tags.each(function (t) { %>
      <a class="stamp stamp-tag" href="<%- url_for(t.path) %>">✿ <%= t.name %></a>
      <% }) %>
    </div>
    <div class="post-content">
      <%- page.content %>
    </div>
    <% if (theme.comment.waline && theme.comment.waline.serverURL) { %>
    <section class="post-comments">
      <div id="waline-comment"></div>
    </section>
    <% } %>
  </article>
  <aside class="toc-wrap">
    <div class="card toc-card">
      <h3>✿ 目录</h3>
      <nav id="toc"></nav>
    </div>
  </aside>
</div>
