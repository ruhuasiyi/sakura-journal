<div class="post-layout">
  <article class="card post-content-wrap">
    <span class="tape" aria-hidden="true"></span>
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <span class="stamp"><%= date(page.date, 'YYYY-MM-DD') %></span>
      <% page.tags.each(function (t) { %>
      <a class="stamp stamp-tag" href="<%- url_for(t.path) %>">✿ <%= t.name %></a>
      <% }) %>
    </div>
    <div class="post-content">
      <%- page.content %>
    </div>
    <% if (theme.comment.giscus.repo) { %>
    <section class="comments">
      <script src="https://giscus.app/client.js"
        data-repo="<%= theme.comment.giscus.repo %>"
        data-repo-id="<%= theme.comment.giscus.repo_id %>"
        data-category="<%= theme.comment.giscus.category %>"
        data-category-id="<%= theme.comment.giscus.category_id %>"
        data-mapping="pathname" data-strict="0" data-reactions-enabled="1"
        data-emit-metadata="0" data-input-position="top" data-theme="light"
        data-lang="zh-CN" data-loading="lazy" crossorigin="anonymous" async>
      </script>
    </section>
    <% } %>
  </article>
  <aside class="toc-wrap">
    <div class="card toc-card">
      <h3>✿ 目录</h3>
      <nav id="toc"></nav>
    </div>
  </aside>
</div>
