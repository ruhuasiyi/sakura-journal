<div class="post-layout">
  <% function vtName(path) { var h = 5381; for (var i = 0; i < path.length; i++) { h = ((h << 5) + h + path.charCodeAt(i)) >>> 0; } return 'post-' + h.toString(36); } %>
  <article class="card post-content-wrap" style="view-transition-name: <%= vtName(page.path) %>">
    <span class="tape" aria-hidden="true"></span>
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <span class="stamp"><%= date(page.date, 'YYYY-MM-DD') %></span>
      <% page.tags.each(function (t) { %>
      <a class="stamp stamp-tag" href="<%- url_for(t.path) %>">✿ <%= t.name %></a>
      <% }) %>
    </div>
    <div class="post-content">
      <%- page.content %>
    </div>
    <% if (theme.comment.giscus.repo && theme.comment.giscus.category_id) { %>
    <section class="comments">
      <script src="https://giscus.app/client.js"
        data-repo="<%= theme.comment.giscus.repo %>"
        data-repo-id="<%= theme.comment.giscus.repo_id %>"
        data-category="<%= theme.comment.giscus.category %>"
        data-category-id="<%= theme.comment.giscus.category_id %>"
        data-mapping="pathname" data-strict="0" data-reactions-enabled="1"
        data-emit-metadata="0" data-input-position="top" data-theme="light"
        data-lang="zh-CN" data-loading="lazy" crossorigin="anonymous" async>
      </script>
      <script>
      (function () {
        // giscus 是异步脚本，解析阶段先把 data-theme 改成当前主题再让它加载
        var s = document.querySelector('script[src*="giscus"]');
        var base = 'https://rhsy.moe/css/giscus-';
        if (s) s.setAttribute('data-theme', base +
          (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light') + '.css');
      })();
      </script>
    </section>
    <% } %>
  </article>
  <aside class="toc-wrap">
    <div class="card toc-card">
      <h3>✿ 目录</h3>
      <nav id="toc"></nav>
    </div>
  </aside>
</div>
