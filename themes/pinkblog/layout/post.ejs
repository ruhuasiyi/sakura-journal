<div class="post-layout">
  <% function vtName(path) { var h = 5381; for (var i = 0; i < path.length; i++) { h = ((h << 5) + h + path.charCodeAt(i)) >>> 0; } return 'post-' + h.toString(36); } %>
  <article class="card post-content-wrap" style="view-transition-name: <%= vtName(page.path) %>">
    <span class="tape" aria-hidden="true"></span>
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <span class="stamp"><%= date(page.date, 'YYYY-MM-DD') %></span>
      <% page.tags.each(function (t) { %>
      <a class="stamp stamp-tag" href="<%- url_for(t.path) %>">✿ <%= t.name %></a>
      <% }) %>
    </div>
    <div class="post-content">
      <%- page.content %>
    </div>
    <% if (theme.comment.waline && theme.comment.waline.serverURL) { %>
    <section class="post-comments">
      <div class="comments-bar">
        <span class="comments-bar-title">✿ 评论</span>
        <a class="comments-rss" href="<%= theme.comment.waline.serverURL %>/api/comment/rss?path=<%= url_for(page.path) %>" target="_blank" rel="noopener" title="订阅本文评论" aria-label="订阅本文评论"><!-- 图标：lucide-static v1.48.0（ISC License）https://lucide.dev --><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg></a>
      </div>
      <div id="waline-comment"></div>
    </section>
    <% } %>
  </article>
  <aside class="toc-wrap">
    <div class="card toc-card">
      <h3>✿ 目录</h3>
      <nav id="toc"></nav>
    </div>
  </aside>
</div>
