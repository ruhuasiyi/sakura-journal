<article class="card post-card<%= post.cover ? ' has-cover' : '' %>">
  <span class="tape" aria-hidden="true"></span>
  <% if (post.cover) { %>
  <div class="card-blur" style="background-image:url('<%- url_for(post.cover) %>')" aria-hidden="true"></div>
  <a class="post-card-cover" href="<%- url_for(post.path) %>" tabindex="-1" aria-hidden="true">
    <img class="cover-img" src="<%- url_for(post.cover) %>" alt="<%= post.title %>" loading="lazy">
  </a>
  <% } %>
  <div class="post-card-body">
  <h2 class="post-card-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
  <% if (post.cover) { %>
<div class="post-card-peek post-content"><%- post.content.replace(/\s+id="[^"]*"/g, '') %></div>
<% } else { %>
<p class="post-card-excerpt"><%= truncate(strip_html(post.excerpt || post.content), { length: 200 }) %></p>
<% } %>
  <div class="post-card-meta">
    <span class="stamp"><%= date(post.date, 'YYYY-MM-DD') %></span>
    <span class="read-time">约 <%= Math.max(1, Math.ceil(strip_html(post.content).length / 450)) %> 分钟</span>
    <% if (post.tags && post.tags.length) { post.tags.each(function (t) { %>
    <a class="stamp stamp-tag" href="<%- url_for(t.path) %>">✿ <%= t.name %></a>
    <% }); } %>
  </div>
  </div>
</article>
