<article class="card page-card">
  <span class="tape" aria-hidden="true"></span>
  <% if (page.title) { %>
  <h1 class="post-title"><%= page.title %></h1>
  <% } %>
  <div class="post-content">
    <%- page.content %>
  </div>
  <% if (page.waline && theme.comment.waline) { %>
  <div class="comments-bar">
    <span class="comments-bar-title">✿ 留言</span>
    <a class="comments-rss" href="<%= theme.comment.waline.serverURL %>/api/comment/rss?path=<%= url_for(page.path) %>" target="_blank" rel="noopener" title="订阅留言" aria-label="订阅留言"><!-- 图标：lucide-static v1.48.0（ISC License）https://lucide.dev --><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg></a>
  </div>
  <div id="waline-comment" class="page-waline"></div>
  <% } %>
</article>
